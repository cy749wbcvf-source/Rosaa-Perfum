rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in ["ahmedmohyanz@gmail.com"];
    }
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{id} {
      allow create: if request.resource.data.total is number && request.resource.data.items is list;
      allow read, update, delete: if isAdmin();
    }
  }
}